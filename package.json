{
  "name": "fannistic",
  "version": "1.0.0",
  "private": true,
  "description": "Fanni'stic — plateforme du studio créatif : configurateur de projets, demandes de devis, espace client et administration.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate.mjs --soft && next build",
    "start": "node scripts/migrate.mjs && node scripts/bootstrap.mjs && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "bootstrap": "node scripts/bootstrap.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "postinstall": "prisma generate",
    "db:check": "node scripts/migrate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^5.10.0",
    "lucide-react": "^1.55.0",
    "next": "^15.5.28",
    "nodemailer": "^10.1.7",
    "prisma": "^6.19.3",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "playwright": "1.56",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
