# ── Base de données (obligatoire) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fannistic?schema=public"

# ── Sécurité (obligatoire) ──
# Secret de signature des sessions. Générer avec : openssl rand -base64 32
AUTH_SECRET="changez-moi-avec-une-valeur-aleatoire-longue"

# ── URL publique du site (liens dans les e-mails, sitemap, Open Graph) ──
SITE_URL="http://localhost:3000"

# ── Premier compte administrateur (créé au démarrage s'il n'existe aucun admin) ──
# Laissez vide après la création, ou utilisez : npm run admin:create -- email motdepasse
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── E-mails transactionnels (facultatif, SMTP) ──
# Sans ces valeurs, aucun e-mail n'est envoyé et l'interface l'indique clairement.
# Compatible Resend (smtp.resend.com), Brevo, Mailgun, OVH, Gmail (mot de passe d'application)…
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Expéditeur, ex. "Fanni'stic <bonjour@fannistic.com>"
MAIL_FROM=""
# Adresse qui reçoit les notifications de nouvelles demandes
ADMIN_NOTIFY_EMAIL=""
